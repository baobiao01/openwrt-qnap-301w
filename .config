CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_qnap_qhora-301w=y
CONFIG_KERNEL_PATCHVER="6.6"

# NSS 核心（必须全选）
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge=y

# NSS 固件
CONFIG_PACKAGE_nss-firmware-ipq8074=y

# 万兆 AQR 驱动（301W 必备）
CONFIG_PACKAGE_kmod-aq_phy=y
CONFIG_PACKAGE_kmod-mdio-aqr=y

# WiFi NSS offload
CONFIG_PACKAGE_kmod-mac80211-nss=y
CONFIG_PACKAGE_wifi-nss-support=y

# 关闭无关加速，只留 NSS/ECM
CONFIG_PACKAGE_kmod-fastnat=n
CONFIG_PACKAGE_kmod-xtables-offload=n

# 常用包（你可删改）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
